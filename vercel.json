{
  "buildCommand": "npm run build",
  "outputDirectory": "client/dist",
  "regions": ["fra1"],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/((?!api/.*).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/index.js": {
      "includeFiles": "node_modules/.prisma/**"
    }
  }
}
